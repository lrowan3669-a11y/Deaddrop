# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase dashboard: Project Settings -> API.
# .env.local is gitignored - never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only - never prefix with NEXT_PUBLIC_. Project Settings -> API ->
# "service_role" secret. Used only by the Stripe webhook, which has no user
# session and needs to update an arbitrary user's profile by Stripe
# customer id.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Stripe (Developers -> API keys). Use the *test mode* secret key while
# building, switch to the live key when you're ready to charge real cards.
STRIPE_SECRET_KEY=sk_test_your-secret-key

# Product Catalog -> each product's Price id (starts with price_...).
STRIPE_PRICE_AGENT=price_your-agent-monthly-price-id
STRIPE_PRICE_SECRET=price_your-secret-agent-monthly-price-id

# Developers -> Webhooks -> your endpoint -> Signing secret (starts with
# whsec_...). See README's Stripe setup section for the exact steps.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
